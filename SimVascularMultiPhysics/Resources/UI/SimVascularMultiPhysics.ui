 <resources/>
 <connections>
  <connection>
   <sender>SimVascularMultiPhysics</sender>
   <signal>mrmlSceneChanged(vtkMRMLScene*)</signal>
   <receiver>inputMeshSelector</receiver>
   <slot>setMRMLScene(vtkMRMLScene*)</slot>
  </connection>
