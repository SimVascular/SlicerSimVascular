<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>seqseg</class>
 <widget class="qMRMLWidget" name="seqseg">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>400</width>
    <height>500</height>
   </rect>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QLabel" name="dependencyDescriptorLabel">
     <property name="text">
      <string>The first Run SeqSeg can install PyTorch and nnUNet (several minutes, and Slicer may ask to restart) and then download the selected model weights. The PyTorch and NNUNet extensions are used when they are installed.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="inputsCollapsibleButton">
     <property name="text">
      <string>Inputs</string>
     </property>
     <layout class="QFormLayout" name="formLayout_inputs">
      <item row="0" column="0">
       <widget class="QLabel" name="inputVolumeLabel">
        <property name="text">
         <string>Input Volume:</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="qMRMLNodeComboBox" name="inputSelector">
        <property name="toolTip">
         <string>Select input volume for segmentation</string>
        </property>
        <property name="nodeTypes">
         <stringlist notr="true">
          <string>vtkMRMLScalarVolumeNode</string>
         </stringlist>
        </property>
        <property name="showChildNodeTypes">
         <bool>false</bool>
        </property>
        <property name="addEnabled">
         <bool>false</bool>
        </property>
        <property name="removeEnabled">
         <bool>false</bool>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>inputVolume</string>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="trainDatasetLabel">
        <property name="text">
         <string>Model:</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QComboBox" name="trainDatasetComboBox">
        <property name="toolTip">
         <string>Pretrained model. Choosing one sets the radius and the tracking steps. The line below reads the volume spacing and sets Image Unit and Scale for millimetres or centimetres. If the weights are not already in Slicer's SeqSeg folder, Run SeqSeg asks to download them.</string>
        </property>
        <property name="sizeAdjustPolicy">
         <enum>QComboBox::AdjustToMinimumContentsLengthWithIcon</enum>
        </property>
        <property name="minimumContentsLength">
         <number>12</number>
        </property>
        <property name="editable">
         <bool>false</bool>
        </property>
        <item>
         <property name="text">
          <string>Aorta MR</string>
         </property>
        </item>
       </widget>
      </item>
      <item row="2" column="0" colspan="2">
       <widget class="QLabel" name="presetHintLabel">
        <property name="text">
         <string>Spacing is read from the volume. A millimetre aorta scan is divided by 10 before the network sees it. A centimetre scan is used as stored, and the radius is converted to match.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
        <property name="styleSheet">
         <string>QLabel { color: palette(shadow); font-size: 11px; }</string>
        </property>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="seedsLabel">
        <property name="text">
         <string>Seeds:</string>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="QWidget" name="seedsBlockWidget">
        <layout class="QVBoxLayout" name="seedsBlockLayout">
         <property name="leftMargin">
          <number>0</number>
         </property>
         <property name="topMargin">
          <number>0</number>
         </property>
         <property name="rightMargin">
          <number>0</number>
         </property>
         <property name="bottomMargin">
          <number>0</number>
         </property>
         <property name="spacing">
          <number>6</number>
         </property>
         <item>
          <widget class="QLabel" name="seedsHintLabel">
           <property name="text">
            <string>Each seed is its own line and its own radius. Click the start inside the vessel, then a short step along it. The line is the tracking direction. The millimetre value on that row is the radius.</string>
           </property>
           <property name="wordWrap">
            <bool>true</bool>
           </property>
           <property name="sizePolicy">
            <sizepolicy hsizetype="Preferred" vsizetype="Minimum">
             <horstretch>0</horstretch>
             <verstretch>0</verstretch>
            </sizepolicy>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QWidget" name="seedRowsWidget">
           <property name="sizePolicy">
            <sizepolicy hsizetype="Preferred" vsizetype="Minimum">
             <horstretch>0</horstretch>
             <verstretch>0</verstretch>
            </sizepolicy>
           </property>
           <layout class="QVBoxLayout" name="seedRowsLayout">
            <property name="leftMargin">
             <number>0</number>
            </property>
            <property name="topMargin">
             <number>0</number>
            </property>
            <property name="rightMargin">
             <number>0</number>
            </property>
            <property name="bottomMargin">
             <number>0</number>
            </property>
            <property name="spacing">
             <number>4</number>
            </property>
           </layout>
          </widget>
         </item>
         <item>
          <layout class="QHBoxLayout" name="seedButtonsLayout">
           <item>
            <widget class="QPushButton" name="addSeedButton">
             <property name="text">
              <string>Add Seed</string>
             </property>
             <property name="toolTip">
              <string>Add a seed with its own radius. Click the start, then a point a short distance along the vessel. That distance is the tracking direction, not the radius.</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="clearSeedsButton">
             <property name="text">
              <string>Clear Seeds</string>
             </property>
             <property name="toolTip">
              <string>Remove all SeqSeg seed lines from the scene</string>
             </property>
            </widget>
           </item>
           <item>
            <spacer name="seedButtonsSpacer">
             <property name="orientation">
              <enum>Qt::Horizontal</enum>
             </property>
             <property name="sizeHint" stdset="0">
              <size>
               <width>1</width>
               <height>1</height>
              </size>
             </property>
            </spacer>
           </item>
          </layout>
         </item>
        </layout>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="parametersCollapsibleButton">
     <property name="text">
      <string>Segmentation Limits</string>
     </property>
     <property name="collapsed">
      <bool>true</bool>
     </property>
     <layout class="QFormLayout" name="formLayout_parameters">
      <item row="0" column="0">
       <widget class="QLabel" name="maxStepsLabel">
        <property name="text">
         <string>Tracking steps:</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QSpinBox" name="maxStepsSpinBox">
        <property name="toolTip">
         <string>How many tracking steps to take along the vessel from each seed. One step stops at the seed.</string>
        </property>
        <property name="minimum">
         <number>1</number>
        </property>
        <property name="maximum">
         <number>10000</number>
        </property>
        <property name="value">
         <number>10</number>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>maxSteps</string>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="maxBranchesLabel">
        <property name="text">
         <string>Max Branches:</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QSpinBox" name="maxBranchesSpinBox">
        <property name="toolTip">
         <string>Maximum number of vessel branches to follow, including each seed start. Raised automatically to at least the number of complete seeds so extra seed lines are not ignored.</string>
        </property>
        <property name="minimum">
         <number>1</number>
        </property>
        <property name="maximum">
         <number>100</number>
        </property>
        <property name="value">
         <number>1</number>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>maxBranches</string>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="maxStepsPerBranchLabel">
        <property name="text">
         <string>Max Steps per Branch:</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QSpinBox" name="maxStepsPerBranchSpinBox">
        <property name="toolTip">
         <string>Maximum number of steps per branch</string>
        </property>
        <property name="minimum">
         <number>1</number>
        </property>
        <property name="maximum">
         <number>1000</number>
        </property>
        <property name="value">
         <number>20</number>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>maxStepsPerBranch</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="nnunetCollapsibleButton">
     <property name="text">
      <string>nnUNet Configuration</string>
     </property>
     <property name="collapsed">
      <bool>true</bool>
     </property>
     <layout class="QFormLayout" name="formLayout_nnunet">
      <item row="0" column="0">
       <widget class="QLabel" name="nnunetTypeLabel">
        <property name="text">
         <string>nnUNet Type:</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QComboBox" name="nnunetTypeComboBox">
        <property name="toolTip">
         <string>Type of nnUNet model to use</string>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>nnunetType</string>
        </property>
        <item>
         <property name="text">
          <string>3d_fullres</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>2d</string>
         </property>
        </item>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="unitLabel">
        <property name="text">
         <string>Image Unit:</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QComboBox" name="unitComboBox">
        <property name="toolTip">
         <string>Unit SeqSeg should treat the volume header as. Slicer volumes are millimetres. Choosing a model sets this. Centimetres is only for a volume whose spacing is actually stored in cm.</string>
        </property>
        <property name="currentIndex">
         <number>0</number>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>imageUnit</string>
        </property>
        <item>
         <property name="text">
          <string>mm</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>cm</string>
         </property>
        </item>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="scaleLabel">
        <property name="text">
         <string>Scale:</string>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="QComboBox" name="scaleComboBox">
        <property name="toolTip">
         <string>Relates nnUNet training units to Image Unit. Choosing a model sets this for a millimetre volume: 0.1 if the model was trained in cm, 1 if it was trained in mm, 10 the other way around.</string>
        </property>
        <property name="currentIndex">
         <number>0</number>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>scale</string>
        </property>
        <item>
         <property name="text">
          <string>0.1</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>1</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>10</string>
         </property>
        </item>
       </widget>
      </item>
      <item row="4" column="0" colspan="2">
       <widget class="QLabel" name="scaleExplanationLabel">
        <property name="text">
         <string>Choosing a model sets this for a millimetre volume. 0.1 when the network was trained in cm (aorta, Fontan). 1 when it was trained in mm (coronary). 10 is the other way around.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
        <property name="sizePolicy">
         <sizepolicy hsizetype="Ignored" vsizetype="Preferred">
          <horstretch>0</horstretch>
          <verstretch>0</verstretch>
         </sizepolicy>
        </property>
        <property name="styleSheet">
         <string>QLabel { color: palette(shadow); font-size: 11px; }</string>
        </property>
       </widget>
      </item>
      <item row="5" column="0">
       <widget class="QLabel" name="forceCpuLabel">
        <property name="text">
         <string>Device:</string>
        </property>
       </widget>
      </item>
      <item row="5" column="1">
       <widget class="QCheckBox" name="forceCpuCheckBox">
        <property name="toolTip">
         <string>If checked, nnUNet inference runs on the CPU (adds -cpu to the SeqSeg command). Use this when there is no usable GPU, or when GPU runs fail with a CUDA error; inference is slower on the CPU.</string>
        </property>
        <property name="text">
         <string>Force CPU (no GPU)</string>
        </property>
        <property name="checked">
         <bool>false</bool>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>forceCpu</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="outputCollapsibleButton">
     <property name="text">
      <string>Output</string>
     </property>
     <property name="collapsed">
      <bool>true</bool>
     </property>
     <layout class="QFormLayout" name="formLayout_output">
      <item row="0" column="0">
       <widget class="QLabel" name="outputDirectoryLabel">
        <property name="text">
         <string>Output Directory:</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="ctkPathLineEdit" name="outputDirectoryPathLineEdit">
        <property name="toolTip">
         <string>Directory for pipeline outputs (SeqSeg data layout). Will contain: images/ (input), seeds.json, output/ (segmentation .mha, surface mesh .vtp files)</string>
        </property>
        <property name="filters">
         <set>ctkPathLineEdit::Dirs|ctkPathLineEdit::Writable</set>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="outputSegmentationLabel">
        <property name="text">
         <string>Output Segmentation:</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="qMRMLNodeComboBox" name="outputSegmentationSelector">
        <property name="toolTip">
         <string>Segmentation node the result is written into. Leave this empty and Run creates one. A later run replaces the segments in the selected node.</string>
        </property>
        <property name="noneEnabled">
         <bool>true</bool>
        </property>
        <property name="noneDisplay" stdset="0">
         <string>Create on run</string>
        </property>
        <property name="nodeTypes">
         <stringlist notr="true">
          <string>vtkMRMLSegmentationNode</string>
         </stringlist>
        </property>
        <property name="showChildNodeTypes">
         <bool>false</bool>
        </property>
        <property name="addEnabled">
         <bool>true</bool>
        </property>
        <property name="removeEnabled">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="simvascularLabel">
        <property name="text">
         <string>SimVascular Output:</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QCheckBox" name="simvascularCheckBox">
        <property name="toolTip">
         <string>Writes .pth and .ctgr files for the classic SimVascular application. Mesh Prep, ROM, and MultiPhysics do not read that project.</string>
        </property>
        <property name="text">
         <string>Generate SimVascular project</string>
        </property>
        <property name="checked">
         <bool>false</bool>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>simvascular</string>
        </property>
       </widget>
      </item>
      <item row="3" column="0" colspan="2">
       <widget class="QPushButton" name="browseOutputsButton">
        <property name="text">
         <string>Load Output File...</string>
        </property>
        <property name="toolTip">
         <string>Load one segmentation or surface from a previous run. Run already loads both.</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <layout class="QVBoxLayout" name="executeLayout">
     <item>
      <widget class="QPushButton" name="applyButton">
       <property name="enabled">
        <bool>true</bool>
       </property>
       <property name="toolTip">
        <string>Run vascular segmentation (SeqSeg CLI)</string>
       </property>
       <property name="text">
        <string>Run SeqSeg</string>
       </property>
       <property name="minimumSize">
        <size>
         <width>0</width>
         <height>35</height>
        </size>
       </property>
       <property name="styleSheet">
        <string>QPushButton {
    background-color: #4CAF50;
    color: white;
    font-weight: bold;
    border: 2px solid #45a049;
    border-radius: 4px;
    padding: 5px;
}
QPushButton:hover {
    background-color: #45a049;
}
QPushButton:disabled {
    background-color: #cccccc;
    color: #666666;
    border-color: #999999;
}</string>
       </property>
      </widget>
     </item>
     <item>
      <widget class="QLabel" name="statusLabel">
       <property name="text">
        <string>Ready to run vessel segmentation</string>
       </property>
       <property name="alignment">
        <set>Qt::AlignCenter</set>
       </property>
       <property name="wordWrap">
        <bool>true</bool>
       </property>
       <property name="styleSheet">
        <string>QLabel {
    color: #666666;
    font-style: italic;
    padding: 5px;
}</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QLabel" name="instructionsLabel">
     <property name="text">
      <string>Quick start: load a volume, choose the model, click Add Seed once per vessel and set that row's radius in millimetres, place a short line along the vessel, then Run SeqSeg. The first run may install PyTorch and nnUNet and download weights. The segmentation and surface load when tracking finishes.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
     <property name="sizePolicy">
      <sizepolicy hsizetype="Ignored" vsizetype="Preferred">
       <horstretch>0</horstretch>
       <verstretch>0</verstretch>
      </sizepolicy>
     </property>
     <property name="alignment">
      <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignTop</set>
     </property>
    </widget>
   </item>
   <item>
    <spacer name="verticalSpacer">
     <property name="orientation">
      <enum>Qt::Vertical</enum>
     </property>
     <property name="sizeHint" stdset="0">
      <size>
       <width>20</width>
       <height>40</height>
      </size>
     </property>
    </spacer>
   </item>
  </layout>
 </widget>
 <customwidgets>
  <customwidget>
   <class>qMRMLWidget</class>
   <extends>QWidget</extends>
   <header>qMRMLWidget.h</header>
   <container>1</container>
  </customwidget>
  <customwidget>
   <class>qMRMLNodeComboBox</class>
   <extends>QWidget</extends>
   <header>qMRMLNodeComboBox.h</header>
  </customwidget>
  <customwidget>
   <class>ctkCollapsibleButton</class>
   <extends>QWidget</extends>
   <header>ctkCollapsibleButton.h</header>
   <container>1</container>
  </customwidget>
  <customwidget>
   <class>ctkPathLineEdit</class>
   <extends>QWidget</extends>
   <header>ctkPathLineEdit.h</header>
  </customwidget>
 </customwidgets>
 <resources/>
 <connections>
  <connection>
   <sender>seqseg</sender>
   <signal>mrmlSceneChanged(vtkMRMLScene*)</signal>
   <receiver>inputSelector</receiver>
   <slot>setMRMLScene(vtkMRMLScene*)</slot>
   <hints>
    <hint type="sourcelabel">
     <x>200</x>
     <y>250</y>
    </hint>
    <hint type="destinationlabel">
     <x>300</x>
     <y>50</y>
    </hint>
   </hints>
  </connection>
  <connection>
   <sender>seqseg</sender>
   <signal>mrmlSceneChanged(vtkMRMLScene*)</signal>
   <receiver>outputSegmentationSelector</receiver>
   <slot>setMRMLScene(vtkMRMLScene*)</slot>
   <hints>
    <hint type="sourcelabel">
     <x>200</x>
     <y>250</y>
    </hint>
    <hint type="destinationlabel">
     <x>300</x>
     <y>170</y>
    </hint>
   </hints>
  </connection>
 </connections>
</ui>