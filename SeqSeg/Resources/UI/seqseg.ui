     <layout class="QFormLayout" name="formLayout_nnunet">
      <item row="0" column="0">
       <widget class="QLabel" name="nnunetResultsPathLabel">
        <property name="text">
         <string>nnUNet Results Path:</string>
        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <layout class="QHBoxLayout" name="nnunetPathLayout">
        <item>
         <widget class="ctkDirectoryButton" name="nnunetResultsPathButton">
          <property name="toolTip">
           <string>Path to nnUNet results folder</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="nnunetDownloadLabel">
        <property name="text">
         <string>Pretrained models:</string>
        </property>
        <property name="toolTip">
         <string>No training or command line required: click a button below. Slicer asks where to save; the extension downloads pretrained weights, unpacks them, and can set nnUNet Results Path for you.</string>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <layout class="QVBoxLayout" name="nnunetDownloadsLayout">
        <property name="spacing">
         <number>4</number>
        </property>
        <item>
         <widget class="QPushButton" name="downloadWeightsButton">
          <property name="text">
           <string>Download Aorta Weights</string>
          </property>
          <property name="toolTip">
           <string>One-click download: aorta weights (CT/MR) from Zenodo (236.3 MB). Choose a parent folder when asked; extracts to nnUNet_results and updates nnUNet Results Path when possible.</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="downloadCoronaryWeightsButton">
          <property name="text">
           <string>Download Coronary Weights</string>
          </property>
          <property name="toolTip">
           <string>One-click download: coronary CTA lumen weights from Zenodo (~2.7 MB). Choose a parent folder when asked; extracts to nnUNet_results_coronary; Model Weights can be set to Coronary CT.</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="nnunetTypeLabel">
        <property name="text">
         <string>nnUNet Type:</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QComboBox" name="nnunetTypeComboBox">
        <property name="toolTip">
         <string>Type of nnUNet model to use</string>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>nnunetType</string>
        </property>
        <item>
         <property name="text">
          <string>3d_fullres</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>2d</string>
         </property>
        </item>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="trainDatasetLabel">
        <property name="text">
         <string>Model Weights:</string>
        </property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="QComboBox" name="trainDatasetComboBox">
        <property name="toolTip">
         <string>Pretrained model to use (must match the weights under nnUNet Results Path). Aorta MR/CT were trained in cm units; Coronary CT was trained in mm. Match Image Unit (under Inputs) and Scale (below) accordingly. The real nnUNet dataset id is applied automatically when running SeqSeg.</string>
        </property>
        <property name="sizeAdjustPolicy">
         <enum>QComboBox::AdjustToMinimumContentsLengthWithIcon</enum>
        </property>
        <property name="minimumContentsLength">
         <number>12</number>
        </property>
        <property name="editable">
         <bool>false</bool>
        </property>
        <item>
         <property name="text">
          <string>Aorta MR</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>Aorta CT</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>Coronary CT</string>
         </property>
        </item>
       </widget>
      </item>
      <item row="4" column="0" colspan="2">
       <widget class="QLabel" name="trainDatasetUnitsHintLabel">
        <property name="text">
         <string>Aorta MR and Aorta CT were trained on cm-scale data; Coronary CT was trained on mm-scale data. Set Image Unit under Inputs and Scale below to match your volume and the model.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
        <property name="sizePolicy">
         <sizepolicy hsizetype="Ignored" vsizetype="Preferred">
          <horstretch>0</horstretch>
          <verstretch>0</verstretch>
         </sizepolicy>
        </property>
        <property name="styleSheet">
         <string>QLabel { color: palette(shadow); font-size: 11px; }</string>
        </property>
       </widget>
      </item>
      <item row="5" column="0">
       <widget class="QLabel" name="scaleLabel">
        <property name="text">
         <string>Scale:</string>
        </property>
       </widget>
      </item>
      <item row="5" column="1">
       <widget class="QComboBox" name="scaleComboBox">
        <property name="toolTip">
         <string>Relates nnUNet training voxel units to your Image Unit. Use 10 if the model was trained in mm and your volume is in cm; use 0.1 if the model was trained in cm and your volume is in mm; use 1 when training units match the image (default).</string>
        </property>
        <property name="currentIndex">
         <number>1</number>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>scale</string>
        </property>
        <item>
         <property name="text">
          <string>0.1</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>1</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>10</string>
         </property>
        </item>
       </widget>
      </item>
      <item row="6" column="0" colspan="2">
       <widget class="QLabel" name="scaleExplanationLabel">
        <property name="text">
         <string>Scale matches nnUNet training units to Image Unit: if the model was trained in mm and the image is in cm, choose 10; if the model was trained in cm and the image is in mm, choose 0.1; if units match, choose 1 (default).</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
        <property name="sizePolicy">
         <sizepolicy hsizetype="Ignored" vsizetype="Preferred">
          <horstretch>0</horstretch>
          <verstretch>0</verstretch>
         </sizepolicy>
        </property>
        <property name="styleSheet">
         <string>QLabel { color: palette(shadow); font-size: 11px; }</string>
        </property>
       </widget>
      </item>
      <item row="7" column="0">
       <widget class="QLabel" name="forceCpuLabel">
        <property name="text">
         <string>Device:</string>
        </property>
       </widget>
      </item>
      <item row="7" column="1">
       <widget class="QCheckBox" name="forceCpuCheckBox">
        <property name="toolTip">
         <string>If checked, nnUNet inference runs on the CPU (adds -cpu to the SeqSeg command). Use this when there is no usable GPU, or when GPU runs fail with a CUDA error; inference is slower on the CPU.</string>
        </property>
        <property name="text">
         <string>Force CPU (no GPU)</string>
        </property>
        <property name="checked">
         <bool>false</bool>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>forceCpu</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="ctkCollapsibleButton" name="outputCollapsibleButton">
