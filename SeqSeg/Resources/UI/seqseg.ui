        </property>
        <property name="showChildNodeTypes">
         <bool>false</bool>
        </property>
        <property name="addEnabled">
         <bool>true</bool>
        </property>
        <property name="removeEnabled">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="simvascularLabel">
        <property name="text">
         <string>SimVascular Output:</string>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QCheckBox" name="simvascularCheckBox">
        <property name="toolTip">
         <string>If checked, SeqSeg writes a SimVascular project layout (simvascular/ dirs with .pth, .ctgr).</string>
        </property>
        <property name="text">
         <string>Generate SimVascular project</string>
        </property>
        <property name="checked">
         <bool>false</bool>
        </property>
        <property name="SlicerParameterName" stdset="0">
         <string>simvascular</string>
        </property>
       </widget>
      </item>
      <item row="3" column="0" colspan="2">
       <widget class="QLabel" name="visualizationLabel">
        <property name="text">
         <string>Visualization Results:</string>
        </property>
        <property name="font">
         <font>
          <weight>75</weight>
          <bold>true</bold>
         </font>
        </property>
        <property name="styleSheet">
         <string>QLabel {
    color: #2E86AB;
    padding: 8px 0px 4px 0px;
    border-bottom: 1px solid #E0E0E0;
    margin-bottom: 5px;
}</string>
        </property>
       </widget>
      </item>
      <item row="4" column="0" colspan="2">
       <layout class="QVBoxLayout" name="visualizationButtonsLayout">
        <item>
         <layout class="QHBoxLayout" name="primaryVisualizationLayout">
          <item>
           <widget class="QPushButton" name="loadSegmentationButton">
            <property name="text">
             <string>Load Segmentation</string>
            </property>
            <property name="toolTip">
             <string>Load the latest segmentation (.mha) file as an overlay</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="loadSurfaceMeshButton">
            <property name="text">
             <string>Load Surface Mesh</string>
            </property>
            <property name="toolTip">
             <string>Load the latest 3D surface mesh (.vtp) file</string>
            </property>
           </widget>
          </item>
         </layout>
        </item>
        <item>
         <widget class="QPushButton" name="browseOutputsButton">
          <property name="text">
           <string>Browse All Output Files</string>
          </property>
          <property name="toolTip">
           <string>Browse and selectively load all output files from the results directory</string>
