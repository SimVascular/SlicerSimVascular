      <item row="1" column="1">
       <widget class="QSpinBox" name="maxBranchesSpinBox">
        <property name="toolTip">
         <string>Maximum number of vessel branches to follow, including each seed start. Raised automatically to at least the number of complete seeds so extra seed lines are not ignored.</string>
